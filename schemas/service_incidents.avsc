{
  "type": "record",
  "name": "service_incidents_value",
  "namespace": "io.confluent.aiops",
  "doc": "Value schema for the service_incidents topic. Repo copy for --dry-run and the schema-vs-DDL drift test (tests/test_schema_vs_ddl.py); live serialization uses the schema Flink registers from sql/source_service_incidents.sql. Two records per incident: one at degradation_start (ended_at null), one at degradation_end (both set); incident_id ties them together.",
  "fields": [
    {"name": "event_time", "type": ["null", {"type": "long", "logicalType": "local-timestamp-millis"}], "default": null},
    {"name": "incident_id", "type": ["null", "string"], "default": null},
    {"name": "service_name", "type": ["null", "string"], "default": null},
    {"name": "incident_type", "type": ["null", "string"], "default": null},
    {"name": "started_at", "type": ["null", {"type": "long", "logicalType": "local-timestamp-millis"}], "default": null},
    {"name": "ended_at", "type": ["null", {"type": "long", "logicalType": "local-timestamp-millis"}], "default": null},
    {"name": "expected_trigger", "type": ["null", "string"], "default": null},
    {"name": "expected_action", "type": ["null", "string"], "default": null},
    {"name": "good_version", "type": ["null", "string"], "default": null}
  ]
}
