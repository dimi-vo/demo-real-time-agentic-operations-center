{
  "type": "record",
  "name": "service_metrics_value",
  "namespace": "io.confluent.aiops",
  "doc": "Value schema for the service_metrics topic. Repo copy for --dry-run and the schema-vs-DDL drift test (tests/test_schema_vs_ddl.py); live serialization uses the schema Flink registers from sql/source_service_metrics.sql.",
  "fields": [
    {"name": "event_time", "type": ["null", {"type": "long", "logicalType": "local-timestamp-millis"}], "default": null},
    {"name": "service_name", "type": ["null", "string"], "default": null},
    {"name": "traffic_count", "type": ["null", "int"], "default": null},
    {"name": "latency_ms", "type": ["null", "double"], "default": null},
    {"name": "error_count", "type": ["null", "int"], "default": null}
  ]
}
