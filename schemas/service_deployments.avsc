{
  "type": "record",
  "name": "service_deployments_value",
  "namespace": "io.confluent.aiops",
  "doc": "Value schema for the service_deployments topic. Repo copy for --dry-run and the schema-vs-DDL drift test; live serialization uses the schema Flink registers from sql/source_service_deployments.sql. The primary key service_name is not in the value: Flink registers it only in the key subject (see service_deployments_key.avsc), as confirmed against the registered schema in Phase 3.",
  "fields": [
    {"name": "version", "type": ["null", "string"], "default": null},
    {"name": "previous_version", "type": ["null", "string"], "default": null},
    {"name": "deployed_at", "type": ["null", {"type": "long", "logicalType": "local-timestamp-millis"}], "default": null},
    {"name": "last_change", "type": ["null", "string"], "default": null},
    {"name": "desired_replicas", "type": ["null", "int"], "default": null},
    {"name": "ready_replicas", "type": ["null", "int"], "default": null},
    {"name": "tier", "type": ["null", "string"], "default": null},
    {"name": "owner_team", "type": ["null", "string"], "default": null},
    {"name": "event_time", "type": ["null", {"type": "long", "logicalType": "local-timestamp-millis"}], "default": null}
  ]
}
