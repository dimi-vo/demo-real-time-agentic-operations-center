{
  "type": "record",
  "name": "cve_answer_key_value",
  "namespace": "io.confluent.aiops",
  "doc": "Value schema for the cve_answer_key topic. Repo copy for --dry-run and the schema-vs-DDL drift test (tests/test_schema_vs_ddl.py); live serialization uses the schema Flink registers from sql/source_cve_answer_key.sql. One record per CVE scan finding, on the same tick, with its expected action (PATCH or DISMISS; null when not critical). For the wall and evaluate only (D-070).",
  "fields": [
    {"name": "event_time", "type": ["null", {"type": "long", "logicalType": "local-timestamp-millis"}], "default": null},
    {"name": "finding_id", "type": ["null", "string"], "default": null},
    {"name": "expected_action", "type": ["null", "string"], "default": null}
  ]
}
